digraph Schema {
graph [rankdir=LR, bgcolor="#f6f8fc", pad="0.4", nodesep="0.65", ranksep="1.4", splines=polyline, fontname="Helvetica", label="Volunteer & Community Service — Relational Schema\nFRD v1.4 • PK primary key / FK foreign key / UK unique • ? nullable", labelloc=t, fontsize=22];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, color="#516784", arrowsize=0.7];
StaffMember [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d5deeb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#18334f"><FONT COLOR="white"><B>StaffMember</B></FONT></TD></TR><TR><TD ALIGN="LEFT">StaffID</TD><TD ALIGN="LEFT">INT</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">StaffName</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">StaffRole</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">DbUsername</TD><TD ALIGN="LEFT">VARCHAR(32)</TD><TD>UK</TD></TR></TABLE>>];
Event [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d5deeb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#18334f"><FONT COLOR="white"><B>Event</B></FONT></TD></TR><TR><TD ALIGN="LEFT">EventID</TD><TD ALIGN="LEFT">INT</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">EventName</TD><TD ALIGN="LEFT">VARCHAR(150)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">EventDate</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT">CoordinatorID</TD><TD ALIGN="LEFT">INT</TD><TD>FK</TD></TR></TABLE>>];
Shift [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d5deeb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#18334f"><FONT COLOR="white"><B>Shift</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ShiftID</TD><TD ALIGN="LEFT">INT</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">EventID</TD><TD ALIGN="LEFT">INT</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">ShiftRole</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Capacity</TD><TD ALIGN="LEFT">INT</TD><TD></TD></TR><TR><TD ALIGN="LEFT">StartDateTime</TD><TD ALIGN="LEFT">DATETIME</TD><TD></TD></TR><TR><TD ALIGN="LEFT">EndDateTime</TD><TD ALIGN="LEFT">DATETIME</TD><TD></TD></TR></TABLE>>];
Volunteer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d5deeb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#18334f"><FONT COLOR="white"><B>Volunteer</B></FONT></TD></TR><TR><TD ALIGN="LEFT">VolunteerID</TD><TD ALIGN="LEFT">INT</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">VolunteerName</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">VolunteerPhoneNumber</TD><TD ALIGN="LEFT">VARCHAR(20)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">VolunteerEmail</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">BackgroundCheck</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD></TD></TR></TABLE>>];
VolunteerShift [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d5deeb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#18334f"><FONT COLOR="white"><B>VolunteerShift</B></FONT></TD></TR><TR><TD ALIGN="LEFT">VolunteerID</TD><TD ALIGN="LEFT">INT</TD><TD>PK / FK</TD></TR><TR><TD ALIGN="LEFT">ShiftID</TD><TD ALIGN="LEFT">INT</TD><TD>PK / FK</TD></TR><TR><TD ALIGN="LEFT">Status</TD><TD ALIGN="LEFT">VARCHAR(40)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">CheckInTime ?</TD><TD ALIGN="LEFT">DATETIME</TD><TD></TD></TR><TR><TD ALIGN="LEFT">CheckOutTime ?</TD><TD ALIGN="LEFT">DATETIME</TD><TD></TD></TR><TR><TD ALIGN="LEFT">HoursApproved ?</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ApprovedBy ?</TD><TD ALIGN="LEFT">INT</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">ApprovedAt ?</TD><TD ALIGN="LEFT">DATETIME</TD><TD></TD></TR></TABLE>>];
VolunteerHours [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d5deeb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#18334f"><FONT COLOR="white"><B>VolunteerHours</B></FONT></TD></TR><TR><TD ALIGN="LEFT">VolunteerID</TD><TD ALIGN="LEFT">INT</TD><TD>PK / FK</TD></TR><TR><TD ALIGN="LEFT">ShiftID</TD><TD ALIGN="LEFT">INT</TD><TD>PK / FK</TD></TR><TR><TD ALIGN="LEFT">HoursWorked</TD><TD ALIGN="LEFT">DECIMAL(5,2)</TD><TD></TD></TR></TABLE>>];
Skill [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d5deeb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#18334f"><FONT COLOR="white"><B>Skill</B></FONT></TD></TR><TR><TD ALIGN="LEFT">SkillCode</TD><TD ALIGN="LEFT">INT</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">SkillName</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD>UK</TD></TR><TR><TD ALIGN="LEFT">SkillDescription</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD></TD></TR></TABLE>>];
VolunteerSkill [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d5deeb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#18334f"><FONT COLOR="white"><B>VolunteerSkill</B></FONT></TD></TR><TR><TD ALIGN="LEFT">VolunteerID</TD><TD ALIGN="LEFT">INT</TD><TD>PK / FK</TD></TR><TR><TD ALIGN="LEFT">SkillCode</TD><TD ALIGN="LEFT">INT</TD><TD>PK / FK</TD></TR></TABLE>>];
AuditLog [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#d5deeb" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#18334f"><FONT COLOR="white"><B>AuditLog</B></FONT></TD></TR><TR><TD ALIGN="LEFT">AuditID</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD>PK</TD></TR><TR><TD ALIGN="LEFT">TableName</TD><TD ALIGN="LEFT">VARCHAR(64)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">Operation</TD><TD ALIGN="LEFT">ENUM(&#x27;INSERT&#x27;, &#x27;UPDATE&#x27;)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">RecordId</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ChangedBy</TD><TD ALIGN="LEFT">VARCHAR(288)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ChangedByStaffID ?</TD><TD ALIGN="LEFT">INT</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">ChangedAt</TD><TD ALIGN="LEFT">DATETIME(6)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">OldValues ?</TD><TD ALIGN="LEFT">JSON</TD><TD></TD></TR><TR><TD ALIGN="LEFT">NewValues</TD><TD ALIGN="LEFT">JSON</TD><TD></TD></TR></TABLE>>];
StaffMember -> Event [label="coordinates",taillabel="1",headlabel="0..N",labeldistance=2];
Event -> Shift [label="contains",taillabel="1",headlabel="0..N",labeldistance=2];
Volunteer -> VolunteerShift [label="receives",taillabel="1",headlabel="0..N",labeldistance=2];
Shift -> VolunteerShift [label="includes",taillabel="1",headlabel="0..N",labeldistance=2];
VolunteerShift -> VolunteerHours [label="produces approved hours",taillabel="1",headlabel="0..1",labeldistance=2];
StaffMember -> VolunteerShift [label="approves",taillabel="0..1",headlabel="0..N",labeldistance=2];
Volunteer -> VolunteerSkill [label="has",taillabel="1",headlabel="0..N",labeldistance=2];
Skill -> VolunteerSkill [label="classifies",taillabel="1",headlabel="0..N",labeldistance=2];
StaffMember -> AuditLog [label="attributed to",taillabel="0..1",headlabel="0..N",labeldistance=2];
}
