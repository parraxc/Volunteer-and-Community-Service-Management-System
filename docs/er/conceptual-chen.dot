note [shape=note,label="HoursWorked is stored after approval.\nVolunteerShift / VolunteerSkill have composite keys.\nApproval is optional; every approved-hours row has one assignment.\nAll physical columns and SQL types are in relational-schema.svg.",fontsize=11];
